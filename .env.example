# Stripe (test mode) — fill in from https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# A-Bid's take rate on each guest payment (percent). Default 12.
PLATFORM_FEE_PERCENT=12

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# Server port (default 5000)
PORT=5000
